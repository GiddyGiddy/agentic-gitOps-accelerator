[Unit]
Description=GitOps image publisher single-build runner
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/gitlab-runner run-single --config /etc/gitlab-runner/image-publisher.toml --runner gitops-image-publisher --max-builds 1 --wait-timeout 300
Restart=no
KillSignal=SIGQUIT
TimeoutStopSec=infinity
